{
  "name": "flutter-weather-app-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Flutter Weather App using Playwright and Appium",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "build:apk": "flutter build apk --debug",
    "test:appium": "wdio run wdio.conf.js",
    "test:appium:android": "wdio run wdio.conf.js --platform android",
    "test:appium:ios": "wdio run wdio.conf.js --platform ios"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/logger": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.1.0",
    "appium-uiautomator2-driver": "^6.0.2",
    "appium-xcuitest-driver": "^10.4.1",
    "webdriverio": "^9.0.0"
  }
}